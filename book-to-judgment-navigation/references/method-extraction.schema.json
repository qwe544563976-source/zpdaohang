{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/judgment-method-extraction-v2.schema.json",
  "title": "判断方法结构化抽取 v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "source_scope", "source_records", "methods"],
  "properties": {
    "schema_version": {"const": "judgment-method-extraction/v2"},
    "batch": {"$ref": "#/$defs/batch"},
    "source_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_record"}
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/method"}
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "book_id",
        "edition_id",
        "artifact_scope",
        "pilot_only",
        "publishable",
        "book_strategy",
        "chapter_features",
        "requested_review",
        "consecutive_clean_batches",
        "review_cycle_position"
      ],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "book_id": {"type": "string", "minLength": 1},
        "edition_id": {"type": "string", "minLength": 1},
        "artifact_scope": {"enum": ["FORMAL", "PILOT_TEMP"]},
        "pilot_only": {"type": "boolean"},
        "publishable": {"const": false},
        "book_strategy": {"enum": ["rule_book", "case_book"]},
        "chapter_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "simple_house_placement",
              "dasha_or_transit",
              "multi_planet_combination",
              "complex_yoga",
              "calculation_rule",
              "other"
            ]
          }
        },
        "requested_review": {"enum": ["full", "sample"]},
        "consecutive_clean_batches": {"type": "integer", "minimum": 0},
        "review_cycle_position": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "logic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact_key"],
          "properties": {
            "fact_key": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "operands"],
          "properties": {
            "operator": {"enum": ["AND", "OR", "NOT"]},
            "operands": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/logic"}
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "availability", "role"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "availability": {"enum": ["always", "conditional"]},
        "role": {
          "enum": [
            "context",
            "risk_condition",
            "phase_condition",
            "remedy_condition",
            "evidence_condition"
          ]
        }
      }
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_atom_id", "semantic_class", "risk_flags"],
      "properties": {
        "evidence_atom_id": {"type": "string", "minLength": 1},
        "semantic_class": {
          "enum": [
            "judgment_method",
            "condition_result",
            "exception_boundary",
            "calculation_rule",
            "foundational_knowledge",
            "case_or_commentary"
          ]
        },
        "risk_flags": {"$ref": "#/$defs/string_list"},
        "disposition": {
          "enum": ["method_step", "knowledge_only", "reviewed_no_method", "case_or_auxiliary"]
        }
      }
    },
    "term_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "claim"],
      "properties": {
        "quote": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "claim_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "results"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/term_pair"}
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/term_pair"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_atom_id", "quote"],
      "properties": {
        "evidence_atom_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "time_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "fact_keys"],
      "properties": {
        "kind": {"enum": ["none", "period", "phase"]},
        "label": {"type": "string", "minLength": 1},
        "fact_keys": {"$ref": "#/$defs/string_list"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "phase"}}},
          "then": {"properties": {"fact_keys": {"minItems": 1}}}
        }
      ]
    },
    "conditional_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "required_fact_keys"],
      "properties": {
        "when": {"$ref": "#/$defs/logic"},
        "required_fact_keys": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "alternative_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "condition_logic", "required_fact_keys"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "condition_logic": {"$ref": "#/$defs/logic"},
        "required_fact_keys": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "alternative_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "branches"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/alternative_branch"}
        }
      }
    },
    "exception_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "evidence_atom_ids", "condition_logic"],
      "properties": {
        "type": {"enum": ["exception", "cancellation", "mitigation", "limitation"]},
        "evidence_atom_ids": {"$ref": "#/$defs/non_empty_strings"},
        "condition_logic": {"$ref": "#/$defs/logic"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "applicability_scope",
        "minimum_supported_claim",
        "claim_terms",
        "time_scope",
        "produced_fact_keys",
        "required_fact_keys",
        "condition_logic",
        "conditional_requirements",
        "alternative_groups",
        "concession_conditions",
        "context_reference",
        "context_bindings",
        "source_status",
        "evidence",
        "exception_relations",
        "forbidden_extensions"
      ],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "applicability_scope": {"type": "string", "minLength": 1},
        "minimum_supported_claim": {"type": "string", "minLength": 1},
        "claim_terms": {"$ref": "#/$defs/claim_terms"},
        "time_scope": {"$ref": "#/$defs/time_scope"},
        "produced_fact_keys": {"$ref": "#/$defs/string_list"},
        "required_fact_keys": {"$ref": "#/$defs/non_empty_strings"},
        "condition_logic": {"$ref": "#/$defs/logic"},
        "conditional_requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/conditional_requirement"}
        },
        "alternative_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/alternative_group"}
        },
        "concession_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/logic"}
        },
        "context_reference": {"type": "boolean"},
        "context_bindings": {"$ref": "#/$defs/string_list"},
        "source_status": {
          "enum": [
            "repeated_support",
            "single_explicit_source",
            "structure_hint_only",
            "synthesized_candidate",
            "no_source_in_scope"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "exception_relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/exception_relation"}
        },
        "forbidden_extensions": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "retrieval_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_queries", "counter_queries", "boundary_queries", "method_queries"],
      "properties": {
        "support_queries": {"$ref": "#/$defs/non_empty_strings"},
        "counter_queries": {"$ref": "#/$defs/non_empty_strings"},
        "boundary_queries": {"$ref": "#/$defs/non_empty_strings"},
        "method_queries": {"$ref": "#/$defs/non_empty_strings"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "title",
        "generalization_scope",
        "source_status",
        "fact_binding_status",
        "upstream_issue_ids",
        "user_intents",
        "facts",
        "dependencies",
        "steps",
        "retrieval_plan",
        "stop_conditions",
        "spine_slot_hint"
      ],
      "properties": {
        "method": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "target_house": {"type": "integer", "minimum": 1, "maximum": 12},
        "generalization_scope": {"enum": ["general_rule", "single_case_only"]},
        "source_status": {
          "enum": [
            "repeated_support",
            "single_explicit_source",
            "structure_hint_only",
            "synthesized_candidate",
            "no_source_in_scope"
          ]
        },
        "fact_binding_status": {"enum": ["unmapped", "mapped", "unavailable"]},
        "upstream_issue_ids": {"$ref": "#/$defs/string_list"},
        "user_intents": {"$ref": "#/$defs/non_empty_strings"},
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fact"}
        },
        "dependencies": {"$ref": "#/$defs/string_list"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "retrieval_plan": {"$ref": "#/$defs/retrieval_plan"},
        "stop_conditions": {"$ref": "#/$defs/non_empty_strings"},
        "spine_slot_hint": {"type": "null"}
      }
    }
  }
}
